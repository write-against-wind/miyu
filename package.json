{
  "name": "miyu-vault",
  "version": "1.0.1",
  "description": "密屿 · 离线加密密码本",
  "private": true,
  "main": "src/main.cjs",
  "author": "Miyu",
  "license": "UNLICENSED",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "node scripts/start.cjs",
    "test": "node --test tests/vault.test.cjs",
    "test:e2e": "node scripts/e2e.cjs",
    "build": "electron-builder --win portable --x64",
    "build:dir": "electron-builder --win --dir --x64"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "local.miyu.vault",
    "productName": "密屿密码本",
    "artifactName": "Miyu-Vault-${version}-${arch}.${ext}",
    "directories": { "output": "dist", "buildResources": "assets" },
    "files": ["src/**/*", "assets/icon.png", "package.json"],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": { "artifactName": "Miyu-Vault-${version}-${arch}.exe" }
  }
}
